<Window x:Class="ManajemenMahasiswa_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManajemenMahasiswa_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="2,4,-2,-4">
        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="STUDENT REGISTRATION" FontSize="20" FontWeight="Bold" FontFamily="Verdana"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,43,0,0" TextWrapping="Wrap" Text="Nama:" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="12,170,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="377" Height="25" TextChanged="TextBox_TextChanged_2"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,95,0,0" TextWrapping="Wrap" Text="NRP:" VerticalAlignment="Top"/>
        <TextBox x:Name="Nama" HorizontalAlignment="Left" Margin="12,64,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="377" TextChanged="TextBox_TextChanged" Height="25"/>
        <Button Content="Save" HorizontalAlignment="Left" Margin="337,383,0,0" VerticalAlignment="Top" Background="#FF0061FF" FontWeight="Bold" FontSize="14" Foreground="White" Width="50" Height="29" RenderTransformOrigin="0,0" Click="Button_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="12,149,0,0" TextWrapping="Wrap" Text="Jurusan:" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="12,124,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="377" Height="25" TextChanged="TextBox_TextChanged_1"/>
        <TextBlock HorizontalAlignment="Left" Margin="12,204,0,0" TextWrapping="Wrap" Text="Jenis Kelamin:" VerticalAlignment="Top"/>
        <RadioButton Content="Laki-laki" HorizontalAlignment="Left" Margin="113,205,0,0" VerticalAlignment="Top" Checked="RadioButton_Checked_1"/>
        <RadioButton Content="Perempuan" HorizontalAlignment="Left" Margin="233,205,0,0" VerticalAlignment="Top" Checked="RadioButton_Checked"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,225,0,0" TextWrapping="Wrap" Text="Tanggal Lahir:" VerticalAlignment="Top"/>
        <DatePicker Margin="10,246,413,0" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,275,0,0" TextWrapping="Wrap" Text="Alamat:" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="10,296,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="377" Height="40" TextChanged="TextBox_TextChanged_3"/>
        <TextBlock HorizontalAlignment="Left" Margin="15,341,0,0" TextWrapping="Wrap" Text="No.Telp:" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="10,362,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="150" TextChanged="TextBox_TextChanged_4"/>
        <Button Content="Update" HorizontalAlignment="Left" Margin="262,383,0,0" VerticalAlignment="Top" Background="#FF8C9AB0" FontWeight="Bold" FontSize="14" Foreground="White" Width="60" Height="29" RenderTransformOrigin="0,0" Click="Button_Click_1"/>
        <Button Content="Reset" HorizontalAlignment="Left" Margin="189,383,0,0" VerticalAlignment="Top" Background="#FF4F4F4F" FontWeight="Bold" FontSize="14" Foreground="White" Width="56" Height="29" RenderTransformOrigin="0,0" Click="Button_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="409,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Data Mahasiswa" FontSize="20" FontWeight="Bold" FontFamily="Verdana"/>
        <TextBlock HorizontalAlignment="Left" Margin="409,43,0,0" TextWrapping="Wrap" Text="Ketik untuk mencari:" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="409,64,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="377" Height="25" SelectionOpacity="0.2" TextChanged="TextBox_TextChanged_5"/>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="409,99,27,63" SelectionChanged="ListBox_SelectionChanged"/>
        <Button Content="Hapus" HorizontalAlignment="Left" Margin="717,383,0,0" VerticalAlignment="Top" Background="Red" FontWeight="Bold" FontSize="14" Foreground="White" Width="56" Height="29" RenderTransformOrigin="0,0" Click="Button_Click"/>

    </Grid>
</Window>
